            let counts = Array.from({length: 10}, () => Math.floor(Math.random() * 12) + 4);
            let total = counts.reduce((a, b) => a + b, 0);
            let percentages = counts.map(c => Math.round((c / total) * 100));

            let diff = 100 - percentages.reduce((a, b) => a + b, 0);
            percentages[0] += diff;

            let maxVal = Math.max(...percentages);
            let minVal = Math.min(...percentages);
            let maxIndex = percentages.indexOf(maxVal);
            let minIndex = percentages.indexOf(minVal);

            for (let i = 0; i < 10; i++) {
                let bar = document.getElementById(`bar-${i}`);
                let valLabel = document.getElementById(`val-${i}`);
                
                valLabel.innerText = percentages[i] + '%';
