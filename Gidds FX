        .logo span {
            color: var(--accent-red);
        }

        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            margin-left: 20px;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: var(--text-primary);
        }

        .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .hero-banner {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 40px;
            text-align: center;
            margin-bottom: 30px;
        }

        .hero-banner h1 {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .hero-banner p {
            color: var(--text-secondary);
            margin-bottom: 20px;
        }

        .btn-main {
            background-color: var(--accent-red);
            color: white;
            border: none;
            padding: 12px 28px;
            font-size: 16px;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-main:hover {
            background-color: #e03e3e;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 25px;
        }

        @media (max-width: 768px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
            }
        }

        .panel-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .panel-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px;
        }

        .digit-container {
            display: grid;
            grid-template-columns: repeat(10, 1fr);
            gap: 8px;
            margin-top: 15px;
        }

        .digit-bar-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            height: 180px;
            justify-content: flex-end;
        }

        .digit-bar {
            width: 100%;
            background-color: #1e293b;
            border-radius: 4px;
            position: relative;
            transition: height 0.4s ease, background-color 0.3s ease;
        }

        .digit-bar.high-freq {
            background-color: var(--accent-green) !important;
        }

        .digit-bar.low-freq {
            background-color: var(--accent-red) !important;
        }

        .digit-value {
            font-size: 11px;
            color: var(--text-secondary);
            margin-bottom: 5px;
        }

        .digit-label {
            margin-top: 8px;
            font-weight: bold;
            font-size: 14px;
        }

        .rule-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 12px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        .rule-item span {
            color: var(--accent-green);
            margin-right: 10px;
            font-weight: bold;
        }
    </style>
</head>
